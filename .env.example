# Postgres (Neon). Use a connection string do *pooler* em produção — o app roda
# em funções serverless e abrir conexões diretas esgota o limite do Neon.
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.sa-east-1.aws.neon.tech/webscout?sslmode=require"

# Senha única de acesso ao app (Basic Auth, single user).
# Gere uma forte: `openssl rand -base64 24`
APP_PASSWORD="troque-esta-senha"

# Segredo usado para assinar o cookie de sessão. Gere um valor aleatório longo:
# `openssl rand -base64 32`
AUTH_SECRET="troque-este-segredo"

# User-Agent enviado ao Nominatim/Overpass. A política do OSM exige identificação
# com forma de contato — troque pelo seu repositório ou e-mail.
OSM_USER_AGENT="webscout-prospector/0.1 (+https://github.com/seu-usuario/webscout)"
