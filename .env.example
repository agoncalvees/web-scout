# Postgres (Neon). Use a connection string do *pooler* em produção — o app roda
# em funções serverless e abrir conexões diretas esgota o limite do Neon.
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.sa-east-1.aws.neon.tech/webscout?sslmode=require"

# Senha única de acesso ao app (Basic Auth, single user).
# Gere uma forte: `openssl rand -base64 24`
APP_PASSWORD="troque-esta-senha"

# Segredo usado para assinar o cookie de sessão. Gere um valor aleatório longo:
# `openssl rand -base64 32`
AUTH_SECRET="troque-este-segredo"

# User-Agent enviado ao Nominatim/Overpass. A política do OSM exige identificação
# com forma de contato — troque pelo seu repositório ou e-mail.
OSM_USER_AGENT="webscout-prospector/0.1 (+https://github.com/seu-usuario/webscout)"

# Recomendado: busca o site oficial na web. O plano gratuito da Tavily oferece
# 1.000 créditos/mês sem cartão; o app guarda a chave somente no servidor.
TAVILY_API_KEY=""

# Teto interno de buscas/mês. O app nunca aceita mais de 900, deixando margem
# para testes manuais dentro dos 1.000 créditos do plano gratuito.
TAVILY_MONTHLY_LIMIT="900"

# Alternativa opcional: confirma no Google Places se os candidatos têm site.
# Mantenha a chave somente no servidor e restrinja-a à Places API (New).
GOOGLE_PLACES_API_KEY=""

# Limite interno de consultas Place Details por mês. O app nunca aceita mais de
# 900, deixando margem abaixo da franquia mensal gratuita atual de 1.000.
GOOGLE_PLACES_MONTHLY_LIMIT="900"
